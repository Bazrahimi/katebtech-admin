{
  "name": "@katebtech/admin",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./cloudinary": {
      "types": "./dist/cloudinary/index.d.ts",
      "default": "./dist/cloudinary/index.js"
    },
    "./cloudinary/delete-server": {
      "types": "./dist/cloudinary/deleteServer.d.ts",
      "default": "./dist/cloudinary/deleteServer.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "clean": "rm -rf dist",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@katebtech/core": "github:Bazrahimi/katebtech-core#main",
    "@katebtech/emails": "github:Bazrahimi/katebtech-emails#main",
    "@katebtech/layout": "github:Bazrahimi/katebtech-layout#main",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint-config-prettier": "^10.1.8",
    "next": "^16.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@katebtech/core": "0.1.0",
    "@katebtech/layout": "0.1.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "jose": "^6.0.0",
    "next": "16.1.6",
    "postgres": "^3.4.8",
    "react-icons": "^5.6.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.6",
    "cloudinary": "^2.8.0"
  }
}
